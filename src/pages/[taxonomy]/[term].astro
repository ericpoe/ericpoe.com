---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PostListing from '../../components/PostListing.astro';
import { taxonomyListingPaths } from '../../utils/blog';

export const getStaticPaths = (async () => taxonomyListingPaths()) satisfies GetStaticPaths;

const listing = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<PostListing {...listing} />
